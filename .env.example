# Required for looking up public profiles (GraphQL needs a token).
# Fine-grained PAT: Public repositories → Read-only
# Classic PAT: public_repo
GITHUB_TOKEN=

# OAuth App — https://github.com/settings/developers
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of this deployment, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown in the footer. GitHub asks for a support email when you join the Developer Program.
NEXT_PUBLIC_SUPPORT_EMAIL=
